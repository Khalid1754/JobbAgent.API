# Kopiera till .env och fyll i. .env checkas inte in i git.

# Gratis och snabb AI-nyckel från Groq: https://console.groq.com/keys (samma som i TrAInr och AgentFlow funkar)
GROQ_API_KEY=

# Valfritt: Groq-modell (standard: openai/gpt-oss-120b, snabbare: openai/gpt-oss-20b)
GROQ_MODEL=

# Valfritt: sök även bland annonser från LinkedIn, Indeed, Glassdoor m.fl. via JSearch (gratis ca 200 sökningar/månad).
# Skapa ett konto på https://rapidapi.com, prenumerera på JSearch (Basic, gratis) och kopiera din X-RapidAPI-Key hit.
RAPIDAPI_KEY=

SA_PASSWORD=JobbAgent_Dev123!
